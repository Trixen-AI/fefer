modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
EXIT_KEEPER_ADDRESS = "0x62534e5d7f14ad180bb8d5eeed9e4433aa56132c"
VITE_EXIT_KEEPER_ADDRESS = "0x62534e5d7f14ad180bb8d5eeed9e4433aa56132c"

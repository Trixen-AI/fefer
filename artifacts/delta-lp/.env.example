# Copy to .env for local dev: cp artifacts/delta-lp/.env.example artifacts/delta-lp/.env
# On Netlify these are set in netlify.toml [build.environment] (or the UI).

# Required by vite.config.ts — the build fails if either is missing.
PORT=25278
BASE_PATH=/

# Empty = call same-origin /api/*, served by netlify/functions/api.mjs.
# Point at a standalone API host only if you deploy artifacts/api-server separately.
VITE_API_BASE_URL=

VITE_CHAIN_ID=4663
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
VITE_CHAIN_NAME=Robinhood Chain
VITE_NATIVE_CURRENCY_NAME=Ether
VITE_NATIVE_CURRENCY_SYMBOL=ETH
VITE_BLOCK_EXPLORER_URL=https://robinhoodchain.blockscout.com
VITE_UNISWAP_V3_POSITION_MANAGER=0x73991a25c818bf1f1128deaab1492d45638de0d3
VITE_UNISWAP_V3_FACTORY=0x1f7d7550b1b028f7571e69a784071f0205fd2efa
VITE_LP_TOKEN0_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
VITE_LP_TOKEN1_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
VITE_LP_TOKEN0_LABEL=WETH
VITE_LP_TOKEN1_LABEL=USDG
VITE_EXIT_KEEPER_ADDRESS=0x62534e5d7f14ad180bb8d5eeed9e4433aa56132c
